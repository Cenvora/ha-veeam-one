{
  "entity": {
    "sensor": {
      "version": { "default": "mdi:information-outline" },
      "active_alarms": {
        "default": "mdi:alarm-light",
        "state": { "0": "mdi:alarm-light-off-outline" }
      },
      "error_alarms": {
        "default": "mdi:alert-circle",
        "state": { "0": "mdi:alert-circle-check-outline" }
      },
      "warning_alarms": {
        "default": "mdi:alert",
        "state": { "0": "mdi:alert-outline" }
      },
      "license_type": { "default": "mdi:license" },
      "license_package": { "default": "mdi:package-variant" },
      "license_company": { "default": "mdi:domain" },
      "license_instances": { "default": "mdi:counter" },
      "license_sockets": { "default": "mdi:cpu-64-bit" },
      "license_days_remaining": { "default": "mdi:calendar-clock" },
      "license_support_days_remaining": { "default": "mdi:lifebuoy" },
      "license_unit_used": { "default": "mdi:counter" },
      "license_unit_licensed": { "default": "mdi:counter" },
      "license_unit_used_percentage": { "default": "mdi:percent" },
      "collection_count": { "default": "mdi:database-outline" },
      "collection_health": { "default": "mdi:heart-pulse" },
      "status": { "default": "mdi:information-outline" },
      "last_run": { "default": "mdi:clock-check-outline" },
      "last_run_duration": { "default": "mdi:timer-outline" },
      "average_run_duration": { "default": "mdi:timer-sand" },
      "last_transferred_data": { "default": "mdi:transfer" },
      "processed_items": { "default": "mdi:format-list-checks" },
      "capacity": { "default": "mdi:harddisk" },
      "free_space": { "default": "mdi:harddisk" },
      "used_space": { "default": "mdi:harddisk" },
      "running_tasks": { "default": "mdi:progress-clock" },
      "days_until_out_of_space": { "default": "mdi:calendar-alert" },
      "free_space_percentage": { "default": "mdi:harddisk" }
    },
    "binary_sensor": {
      "license_expired": { "default": "mdi:license" },
      "license_support_expired": { "default": "mdi:lifebuoy" }
    }
  },
  "services": {
    "resolve_alarm": { "service": "mdi:alarm-check" }
  }
}
